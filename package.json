{
  "name": "task-worklet",
  "version": "0.1.0",
  "description": "Streamlined processing of tasks in a shared threadpool. Works in both browser and Node.js environments.",
  "source": "src/index.js",
  "main": "dist/task-worklet.js",
  "umd:main": "dist/task-worklet.js",
  "module": "dist/task-worklet.module.js",
  "exports": {
    ".": {
      "import": "./dist/task-worklet.module.js",
      "require": "./dist/task-worklet.js"
    },
    "./polyfill": "./polyfill/index.js"
  },
  "scripts": {
    "build": "microbundle -f umd,es && microbundle -f iife src/polyfill.js -o polyfill/index.js",
    "test": "eslint \"{src,test}/**/*.test.{mjs,js}\" && karmatic --no-coverage"
  },
  "files": [
    "dist",
    "src",
    "polyfill"
  ],
  "eslintConfig": {
    "extends": [
      "google",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": 2018,
      "sourceType": "module"
    },
    "rules": {
      "require-jsdoc": 0,
      "valid-jsdoc": 0,
      "max-len": 0,
      "guard-for-in": 0,
      "new-cap": 0,
      "prefer-rest-params": 0
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "repository": "developit/task-worklet",
  "keywords": [
    "tasks",
    "task worklet",
    "TaskWorklet",
    "threads",
    "multithreading",
    "worker",
    "web worker",
    "node.js",
    "browser",
    "isomorphic",
    "universal"
  ],
  "author": "Jason Miller <developit@google.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/developit/task-worklet",
  "devDependencies": {
    "eslint": "^7.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^6.11.0",
    "file-loader": "^6.1.0",
    "karmatic": "^2.1.0",
    "microbundle": "^0.12.3",
    "prettier": "^2.1.2",
    "webpack": "^4.44.1"
  },
  "dependencies": {
    "web-worker": "^1.5.0"
  }
}
